  "scope": "Bounded exploratory measurements; optional planar C-link is not a replacement for the baseline release. No calibrated-realism claim.",
  "protocol": {
    "loadingStep": 0.0016666666666666668,
    "loading": "600 gravity steps; grip torso COM; 600 steps target(-4.3,297); 1200 steps target(pouch.x,pouch.y+0.85); drop; 300 settling steps; require isLoaded; clone canonical snapshot; unlatch and observe at most 5 seconds.",
